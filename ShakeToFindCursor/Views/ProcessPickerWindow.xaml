<Window x:Class="ShakeToFindCursor.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:l="clr-namespace:ShakeToFindCursor.Localization"
        Language="{Binding Language, Source={x:Static l:UiText.Current}}"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{l:Loc PickerTitle}"
        Height="500" Width="450"
        MinHeight="400" MinWidth="350"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FB" Foreground="#1F3045"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ShakeBigMouse;component/Views/SettingsButtons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="AccentBrush" Color="#245DB0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F3045"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#52657A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#CAD5E1"/>

        <!-- Process List Item Style -->
        <Style x:Key="ProcessItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource AppSelectionRowStyle}">
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <!-- Search TextBox Style -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F3045"/>
            <Setter Property="BorderBrush" Value="#CAD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#1F3045"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="Placeholder"
                                           Text="{l:Loc Search}"
                                           Foreground="#52657A"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#245DB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{l:Loc RunningApps}"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{l:Loc PickerHelp}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Search Box -->
        <TextBox x:Name="SearchBox" AutomationProperties.Name="{l:Loc Search}" Grid.Row="1"
                 Style="{StaticResource SearchBoxStyle}"
                 Margin="0,0,0,12"
                 TextChanged="SearchBox_TextChanged"/>

        <!-- Process List -->
        <Border Grid.Row="2"
                Background="#EFF3F7"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ListBox x:Name="ProcessList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource ProcessItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ProcessList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <Image Grid.Column="0"
                                   Source="{Binding Icon}"
                                   Width="24" Height="24"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Process Info -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="13" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PathLabel}" ToolTip="{Binding PathLabel}"
                                           FontSize="11"
                                           Foreground="#52657A"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Window Title Preview -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding WindowTitle}"
                                       FontSize="11"
                                       Foreground="#52657A"
                                       VerticalAlignment="Center"
                                       MaxWidth="120"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="3"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,8,0,0"/>

        <!-- Buttons -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnRefresh" Grid.Column="0"
                    Content="{l:Loc Refresh}"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="BtnRefresh_Click"/>

            <Button x:Name="BtnCancel" Grid.Column="2"
                    Content="{l:Loc Cancel}"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>

            <Button x:Name="BtnSelect" Grid.Column="3"
                    Content="{l:Loc AddSelected}"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    Click="BtnSelect_Click"/>
        </Grid>
    </Grid>
</Window>
